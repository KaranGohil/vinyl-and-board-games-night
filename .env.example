# Copy to .env and change the password:  cp .env.example .env

# Database credentials (only used inside Docker). Use a long password made of
# letters and numbers only, e.g. the output of:  openssl rand -hex 24
POSTGRES_USER=vbgn
POSTGRES_PASSWORD=change-me-to-something-long
POSTGRES_DB=vbgn

# The address people use to open the app. Used for links in calendar invites.
# Examples: http://192.168.1.50:8080, https://games.example.com
PUBLIC_URL=http://localhost:8080

# Port the app listens on, on this machine.
HTTP_PORT=8080

# Only for docker-compose.https.yml (Caddy with automatic HTTPS).
DOMAIN=games.example.com

# Only for docker-compose.tunnel.yml (Cloudflare Tunnel).
TUNNEL_TOKEN=
